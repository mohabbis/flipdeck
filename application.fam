App(
    appid="flipdeck",
    name="FlipDeck",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="flipdeck_app",
    stack_size=4096,
    fap_category="Tools",
    fap_icon="assets/icon.bmp",
    fap_icon_assets="assets",
    sources=[
        "src/flipdeck_app.c",
        "src/flipdeck_ui.c",
        "src/profile_manager.c",
        "src/uart_bridge.c",
        "src/usb_hid.c",
        "src/settings.c",
        "src/nfc_bridge.c",
    ],
    # NOTE: unverified - src/nfc_bridge.c links against the firmware's NFC
    # library (nfc/nfc_scanner.h, nfc/nfc_poller.h, nfc/nfc_device.h). This
    # repo has no fbt/ufbt toolchain available to confirm whether an
    # EXTERNAL app needs an explicit `requires=["nfc"]` (or similar) entry
    # here to resolve those symbols at load time, the way some external NFC
    # apps declare dependencies on shared libraries. If `fbt`/`ufbt build`
    # fails to link/load with unresolved nfc_* symbols, this is the first
    # place to check - compare against another external app that uses NFC.
)
